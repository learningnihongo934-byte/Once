{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Once",
  "scopeName": "source.once",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#definition" },
    { "include": "#keywords" }
  ],
  "repository": {
    "comment": { "name": "comment.line.double-dash.once", "match": "--.*$" },
    "string": {
      "name": "string.quoted.double.once",
      "begin": "\"", "end": "\"|$",
      "patterns": [
        { "name": "constant.character.escape.once", "match": "\\\\." },
        { "name": "meta.interpolation.once", "begin": "\\{", "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.once" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.once" } },
          "patterns": [{ "include": "$self" }] }
      ]
    },
    "number": { "name": "constant.numeric.once", "match": "\\b\\d+(\\.\\d+)?\\b" },
    "definition": {
      "match": "^\\s*(to)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": { "1": { "name": "keyword.control.once" }, "2": { "name": "entity.name.function.once" } }
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.once", "match": "\\b(if|then|otherwise|else|end|repeat|times|while|until|forever|for|each|in|from|to|by|give|back|stop|skip|every|when|frame|seconds?|key|pressed|clicked|the)\\b" },
        { "name": "keyword.other.command.once", "match": "\\b(set|change|say|wait|draw|background|clear|play|note|sound|add|remove|hide|show|new)\\b" },
        { "name": "keyword.operator.word.once", "match": "\\b(and|or|not|is|above|below|at|least|most|more|less|than|mod|of|random|any|holding|touches|contains|item)\\b" },
        { "name": "constant.language.once", "match": "\\b(true|false|nothing|edge)\\b" },
        { "name": "variable.language.once", "match": "\\b(width|height|mouse|pi|time|gravity)\\b" },
        { "name": "support.type.shape.once", "match": "\\b(circle|box|line|text|square|rectangle)\\b" },
        { "name": "variable.parameter.setting.once", "match": "\\b(size|color|moving|bouncy|solid|fixed|hidden|outline|angle|wave|volume)\\b" },
        { "name": "support.function.once", "match": "\\b(sqrt|abs|round|floor|ceil|sin|cos|tan|angle|distance|min|max|sum|clamp|number|length|upper|lower|join|split|range|sort|reverse|find|keys|rgb|hsl)(?=\\s*\\()" },
        { "name": "entity.name.function.call.once", "match": "\\b[A-Za-z_][A-Za-z0-9_]*(?=\\()" },
        { "name": "keyword.operator.once", "match": "'s\\b|[-+*/^%=<>!]=?" }
      ]
    }
  }
}
